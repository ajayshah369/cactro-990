PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_booking
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
# Public API URL; also the trusted browser origin for requests that change data.
BE_URL=http://localhost:3000

# Set a randomly generated secret of at least 32 characters; keep it out of Git.
# Generate locally: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# The separate notification worker logs messages; it does not send real email.
NOTIFICATION_POLL_INTERVAL_MS=1000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_MS=1000
NOTIFICATION_LEASE_MS=60000
